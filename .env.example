# AI-NIDS Environment Configuration Template
# Copy this file to `.env` (or `.env.pc1` / `.env.pc2`) and fill in real values
# for your deployment. Real .env* files are gitignored — see
# docs/GAPS_AND_FLAWS.md §3.4 for why they used to be committed.
#
# PC 1: Attack Lab (example: 192.168.100.10)
# PC 2: AI-NIDS SOC & Sensor (example: 192.168.100.30)

# --- Frontend (Vite) ---------------------------------------------------------

# Target AI-NIDS Backend Host & Ports (Hosted on PC 2)
VITE_NIDS_HOST=192.168.100.30
VITE_NIDS_PORT=8000
VITE_NIDS_WS_PORT=8000

# Attacker Controller Host (Hosted on PC 1)
VITE_ATTACKER_HOST=192.168.100.10

# Default Operating Mode: 'DEMO' (pre-scripted simulated telemetry/detections,
# no real sensor or model — see docs/GAPS_AND_FLAWS.md §1-2), 'HYBRID' (same
# simulation, intended for a partially-wired lab), or 'LIVE' (reports
# NOT_CONFIGURED until a real sensor/classifier is implemented and wired in).
VITE_MODE=DEMO

# Client Role Perspective:
# - 'NIDS_SOC'   : Primary SOC detection view (PC 2 default)
# - 'ATTACK_LAB' : Primary Attack Lab controller view (PC 1 default)
# - 'UNIFIED'    : Full access with perspective toggle (single-laptop default)
VITE_CLIENT_ROLE=UNIFIED

# Sent as the X-API-Key header on every control request (lab start/stop,
# threat resolve/inject, notifications). Must match NIDS_API_KEY below.
VITE_API_KEY=

# --- Backend (FastAPI) --------------------------------------------------------

# Safe laboratory target constraint: attack scenarios may ONLY be launched
# against this host. Keep this in sync with VITE_NIDS_HOST above (PC 2).
LAB_TARGET_HOST=192.168.100.30
LAB_SENSOR_HOST=192.168.100.30
LAB_ATTACKER_HOST=192.168.100.10
LAB_SUBNET=192.168.100.0/24

# Required to use any state-mutating endpoint from a non-localhost client
# (lab start/stop, threat resolve/inject, notifications). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank only for a pure single-laptop demo (localhost-only requests are
# still allowed without a key) — see docs/GAPS_AND_FLAWS.md §3.1.
NIDS_API_KEY=

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Include every PC's frontend URL you actually use, e.g. both PC1 and PC2.
NIDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.100.10:5173,http://192.168.100.30:5173

# Per-client-IP rate limit applied to control endpoints.
NIDS_RATE_LIMIT_MAX=20
NIDS_RATE_LIMIT_WINDOW=10

# Set true only while actively editing backend code; leave unset/false for an
# actual lab run (uvicorn's --reload is a dev convenience, not for "production").
NIDS_DEV_RELOAD=false

# Network Transport Preference: AUTO | ETHERNET | WI-FI
VITE_TRANSPORT_MODE=AUTO

# Server Bindings
NIDS_BIND_HOST=0.0.0.0
NIDS_API_PORT=8000
VITE_HOST=0.0.0.0
VITE_PORT=5173
